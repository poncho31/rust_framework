{
  "name": "ia-agent",
  "displayName": "ia_agent",
  "description": "",
  "version": "0.0.1",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.98.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:iaAgentView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ia-agent.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "ia-agent.openChat",
        "title": "Open Chat with IA Agent"
      },
      {
        "command": "ia-agent.openSidebar",
        "title": "Open IA Sidebar"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "iaAgent",
          "title": "Rust Framework : IA Agent",
          "icon": "resources/images/icons/ia-agent-icon-3.svg"
        }
      ]
    },
    "views": {
      "iaAgent": [
        {
          "id": "iaAgentView",
          "name": "IA VIEW",
          "icon": "resources/images/icons/ia-agent-icon.svg",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.98.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "axios": "^1.8.3",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^4.87.3"
  }
}
